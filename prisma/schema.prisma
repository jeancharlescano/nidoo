// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships FamilyMember[]

  feedings Feeding[]
  diapers  DiaperChange[]
  sleeps   SleepSession[]

  invitationsSent FamilyInvitation[] @relation("InvitationSender")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Family {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     FamilyMember[]
  babies      Baby[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id String @id @default(cuid())

  userId   String
  familyId String

  role FamilyRole @default(PARENT)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model FamilyInvitation {
  id String @id @default(cuid())

  familyId String

  email String

  role FamilyRole @default(PARENT)

  token String @unique

  invitedById String

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([familyId])
}

model Baby {
  id String @id @default(cuid())

  familyId String

  firstName String
  birthDate DateTime?

  sex      BabySex?
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  feedings Feeding[]
  diapers  DiaperChange[]
  sleeps   SleepSession[]
}

model Feeding {
  id String @id @default(cuid())

  babyId    String
  createdBy String

  type FeedingType

  quantityMl Int?

  occurredAt DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [createdBy], references: [id])

  @@index([babyId, occurredAt])
}

model SleepSession {
  id String @id @default(cuid())

  babyId    String
  createdBy String

  startAt DateTime
  endAt   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [createdBy], references: [id])

  @@index([babyId, startAt])
}

model DiaperChange {
  id String @id @default(cuid())

  babyId    String
  createdBy String

  type DiaperType

  occurredAt DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [createdBy], references: [id])

  @@index([babyId, occurredAt])
}

enum FeedingType {
  BOTTLE
  BREAST
}

enum DiaperType {
  PEE
  POOP
  BOTH
}

enum FamilyRole {
  PARENT
  ADMIN
}

enum BabySex {
  MALE
  FEMALE
  OTHER
}
